CXX = g++
CXXFLAGS = -std=c++20 -Wall -g -MMD
EXEC = chess
SOURCES = $(wildcard *.cc)
OBJECTS = ${SOURCES:.cc=.o}
DEPENDS = ${OBJECTS:.o=.d}
# just compiles all of the cc stuff and puts everything into an executable

${EXEC}: ${OBJECTS}
	${CXX} ${CXXFLAGS} ${OBJECTS} -o ${EXEC}

-include ${DEPENDS}

.PHONY: clean
clean:
	rm -f ${OBJECTS} ${DEPENDS} ${EXEC}